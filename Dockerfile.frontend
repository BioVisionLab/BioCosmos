# Dockerfile for the frontend

# Stage 1: Build the Next.js application
FROM docker.io/oven/bun:1.3.14 AS builder
WORKDIR /app

# Copy configuration and dependency files
COPY package.json bun.lock ./
COPY next.config.ts ./
COPY tsconfig.json ./
COPY postcss.config.mjs ./
COPY tailwind.config.ts ./

# Copy source code, build scripts, and public assets
COPY src ./src
COPY scripts ./scripts
COPY public ./public

# Install dependencies and build the application
RUN bun install --frozen-lockfile
RUN bun run build

# Stage 2: Create the production image
# The standalone server runs on Node: Next 16.4 fails to load its server runtime
# under Bun ("Expected CommonJS module to have a function wrapper").
FROM docker.io/library/node:24.22.2-trixie-slim

# Apply Debian security updates released since the base image was built, and
# drop npm and corepack, which the server never uses and which bundle their own
# vulnerable dependencies.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# The standalone output holds the server and only the dependencies it traced;
# static assets and public files are served from beside it.
# Owned by the unprivileged node user, which needs to write the image cache.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node

# Expose the port the app runs on
EXPOSE 3000

# Start the application
CMD ["node", "server.js"]
